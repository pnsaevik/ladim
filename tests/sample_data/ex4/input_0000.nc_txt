attrs:
  Conventions: CF-1.8
  date: '2025-10-06'
  history: Created by ladim 2.2.1
  institution: Institute of Marine Research
  source: Lagrangian Advection and Diffusion Model
coords:
  time:
    attrs:
      long_name: time
      standard_name: time
      units: seconds since 1970-01-01
    data:
    - 1441587600
    - 1441587660
    dims:
    - time
data_vars:
  X:
    attrs:
      long_name: particle X-coordinate
    data:
    - 5.0
    - 5.035699844360352
    - 5.0
    dims:
    - particle_instance
  Y:
    attrs:
      long_name: particle Y-coordinate
    data:
    - 4.0
    - 3.9558265209198
    - 4.0
    dims:
    - particle_instance
  Z:
    attrs:
      long_name: particle depth
      positive: down
      standard_name: depth_below_surface
      units: m
    data:
    - 1.0
    - 1.0
    - 1.0
    dims:
    - particle_instance
  instance_offset:
    attrs:
      long_name: particle instance offset for file
    data: 0
    dims: []
  particle_count:
    attrs:
      long_name: number of particles in a given timestep
      ragged_row_count: particle count at nth timestep
    data:
    - 1
    - 2
    dims:
    - time
  pid:
    attrs:
      long_name: particle identifier
    data:
    - 0
    - 0
    - 1
    dims:
    - particle_instance
  release_time:
    attrs:
      long_name: particle release time
      units: seconds since 1970-01-01
    data:
    - 1441587600
    - 1441587660
    dims:
    - particle
dims:
  particle: 2
  particle_instance: 3
  time: 2
